# Review and reuse the existing domain virtual host and certificate paths.
server {
    listen 80;
    server_name synergyhub.top;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name synergyhub.top;
    ssl_certificate /etc/letsencrypt/live/synergyhub.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/synergyhub.top/privkey.pem;
    client_max_body_size 10m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
