# Production example. Never commit actual secrets.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://tournament:CHANGE_ME@127.0.0.1:5432/tournament
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
BOT_API_SECRET=GENERATE_A_SEPARATE_RANDOM_SECRET
AUTH_JWT_TTL_SECONDS=1800
BOT_USERNAME=YOUR_BOT_USERNAME
BOT_TOKEN=
ADMIN_TG_IDS=123456789,987654321
# Tournament dates and partner link are restored from the handoff or set in admin.
PUBLIC_BASE_URL=https://synergyhub.top
BACKEND_URL=http://127.0.0.1:3000
LOCAL_DEMO=false
